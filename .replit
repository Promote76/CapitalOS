modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "generated-finance-artifacts"

[[workflows.workflow]]
name = "generated-finance-artifacts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run check:generated-finance-artifacts"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "libdrm", "libxkbcommon", "pango", "cairo", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "alsa-lib", "mesa", "libgbm"]

[userenv]

[userenv.shared]
GROK_INTELLIGENCE_ENABLED = "true"
XAI_ENABLED = "true"
XAI_MODEL = "grok-4.20-0309-non-reasoning"
CAPITAL_OS_PUBLIC_ORIGIN = "https://capital-os-fund.replit.app"

[userenv.production]
CAPITAL_OS_ALLOWED_ORIGIN = "https://capital-os-fund.replit.app"
CAPITAL_OS_AUDIT_ARCHIVE_DESTINATION = "postgresql://audit_events_archive"
CAPITAL_OS_AUDIT_RETENTION_DAYS = "2555"
CAPITAL_OS_RATE_LIMIT_STORE = "postgres"
CAPITAL_OS_RELIABILITY_OWNER = "internal-reliability"
CAPITAL_OS_TRUSTED_PROXY = "loopback,linklocal,uniquelocal"
OPERATIONS_WORKER_ENABLED = "1"
OPERATIONS_SCHEDULER_ENABLED = "1"

[userenv.development]
CAPITAL_OS_ALLOWED_ORIGIN = "https://a275880a-7e86-4ab1-a13b-802e51c9d9ab-00-10p8dc0vsi6ft.spock.replit.dev"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 25659
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-dd4ef130-f84c-4748-904d-0132753063ba"
